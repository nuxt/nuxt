exports[`template > produces correct output for loading template 1`] = `
":root {
  --nuxt-mint: #00dc82;
  --nuxt-mist: rgba(232, 255, 244, 0.88);
  --nuxt-dim: rgba(0, 220, 130, 0.55);
  --nuxt-logo: min(15vw, 99px);
}
*,
:after,
:before {
  box-sizing: border-box;
}
body,
html {
  margin: 0;
  width: 100%;
  height: 100%;
  background: #000;
  color: var(--nuxt-mist);
}
body {
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  font-family: ui-sans-serif, system-ui, sans-serif;
  -webkit-font-smoothing: antialiased;
}
#nuxt-shader,
svg {
  display: block;
}
#nuxt-shader {
  position: fixed;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  touch-action: none;
  opacity: 0;
  transition: opacity 0.4s ease;
}
.nuxt-lockup {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-end;
  gap: calc(var(--nuxt-logo) / 6);
  text-decoration: none;
  color: inherit;
}
.nuxt-logo-slot {
  width: var(--nuxt-logo);
  height: calc(var(--nuxt-logo) * 32 / 48);
  flex: 0 0 var(--nuxt-logo);
  color: var(--nuxt-mint);
}
.nuxt-logo-slot > svg {
  width: 100%;
  height: 100%;
}
.nuxt-logo-slot > svg > path {
  fill: currentColor;
}
.nuxt-wordmark {
  width: calc(var(--nuxt-logo) * 1.5);
  height: calc(var(--nuxt-logo) * 0.5);
  color: #fff;
  transition: color 0.2s ease;
}
.nuxt-lockup:hover .nuxt-wordmark {
  color: var(--nuxt-mist);
}
.nuxt-corners {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1;
  display: flex;
  justify-content: space-between;
  padding: 22px 26px;
  pointer-events: none;
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 11px;
  font-weight: 500;
  font-variant-numeric: tabular-nums;
  letter-spacing: 0.12em;
  line-height: 1;
}
.nuxt-home {
  color: var(--nuxt-dim);
  text-decoration: none;
  pointer-events: auto;
  transition: color 0.2s ease;
}
.nuxt-home:hover {
  color: var(--nuxt-mist);
}
.nuxt-version {
  color: var(--nuxt-mint);
}
.nuxt-progress {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 1;
}
.nuxt-progress-status {
  margin: 0 0 14px;
  text-align: center;
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 11px;
  font-weight: 500;
  font-variant-numeric: tabular-nums;
  letter-spacing: 0.08em;
  line-height: 1;
  color: var(--nuxt-dim);
  opacity: 0;
  transition: opacity 0.3s ease;
}
.nuxt-loader-bar {
  height: 2px;
  overflow: hidden;
  background: rgba(0, 220, 130, 0.16);
}
.nuxt-loader-bar > span {
  display: block;
  height: 100%;
  width: 32%;
  background: var(--nuxt-mint);
  transform: translateX(-120%);
  animation: nuxt-bar 1.8s ease-in-out infinite;
}
@keyframes nuxt-bar {
  0% {
    transform: translateX(-120%);
  }
  to {
    transform: translateX(360%);
  }
}
@media (prefers-reduced-motion: reduce) {
  .nuxt-loader-bar > span {
    width: 100%;
    transform: none;
    animation: none;
  }
}
"
`;

