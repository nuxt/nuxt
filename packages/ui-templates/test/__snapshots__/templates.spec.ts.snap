  --un-numeric-figure:;
  --un-numeric-spacing:;
  --un-numeric-fraction:;
  --un-border-spacing-x: 0;
  --un-border-spacing-y: 0;
  --un-ring-offset-shadow: 0 0 #0000;
  --un-ring-shadow: 0 0 #0000;
  --un-shadow-inset:;
  --un-shadow: 0 0 #0000;
  --un-ring-inset:;
  --un-ring-offset-width: 0px;
  --un-ring-offset-color: #fff;
  --un-ring-width: 0px;
  --un-ring-color: #93c5fd80;
  --un-blur:;
  --un-brightness:;
