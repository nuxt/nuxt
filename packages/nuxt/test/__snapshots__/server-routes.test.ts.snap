// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`emitServerRoutesModule > emits the module the app layer resolves requests through 1`] = `
"// generated by fetchdts, strategy table+union, 3 routes
// (1 static, 1 dynamic, 1 wildcard)
import type { AnyHTTPMethod, DynamicParam, Endpoint, HTTPMethod, TypedFetchErrorBody, TypedFetchMethods, TypedFetchRequestBody, TypedFetchRequestHeaders, TypedFetchRequestQuery, TypedFetchRequires, TypedFetchResponseBody, TypedFetchResponseHeaders, ValidFetchInput, WildcardParam } from 'nuxt/app'
import type { ServerRoutes } from '@nuxt/schema'
import type { Serialize } from 'nuxt/app'
import type { RequestBodyOf } from '@nuxt/nitro-server/request-types'
type AugmentedServerRoutes = GeneratedServerRoutes & ServerRoutes

export interface GeneratedServerRoutes {
  "/api": {
    "/hello": {
      [Endpoint]: {
        "GET": {
          "response": Serialize<Awaited<ReturnType<typeof import("../server/api/hello.get").default>>>
          "body": RequestBodyOf<typeof import("../server/api/hello.get").default>
        }
        "POST": {
          "response": Serialize<Awaited<ReturnType<typeof import("../server/api/hello.post").default>>>
          "body": RequestBodyOf<typeof import("../server/api/hello.post").default>
        }
      }
    }
    "/users": {
      [DynamicParam]: {
        [Endpoint]: Record<HTTPMethod, {
          "response": Serialize<Awaited<ReturnType<typeof import("../server/api/users/[id]").default>>>
          "body": RequestBodyOf<typeof import("../server/api/users/[id]").default>
        }>
      }
    }
  }
  "/files": {
    [WildcardParam]: {
      [Endpoint]: {
        "GET": {
          "response": Serialize<Awaited<ReturnType<typeof import("../server/routes/files/[...path].get").default>>>
          "body": RequestBodyOf<typeof import("../server/routes/files/[...path].get").default>
        }
      }
    }
  }
}

/**
 * Every path whose every segment is known, mapped to the endpoints registered on it.
 *
 * A fast path rather than the authority: a lookup that misses falls through to the tree, which
 * costs nothing, since a path reached through a parameter has to walk either way.
 */
export interface Exact {
  "/api/hello": GeneratedServerRoutes["/api"]["/hello"][typeof Endpoint]
}

export type Path =
  | "/api/hello"
  | \`/api/users/\${string}\${string}\`
  | \`/files/\${string}\${string}\`
  | "/files"

/**
 * Whether a path resolves, for use in parameter position: \`input: T & ValidInput<T, M>\`.
 *
 * Does not consult \`Exact\`: a lookup where the path is still a type parameter relates a \`keyof\`
 * of every static path once per program, so the table stays where the path is resolved.
 */
export type ValidInput<Path_, Method extends AnyHTTPMethod = 'GET'>
  = ValidFetchInput<AugmentedServerRoutes, Path_, Method>

export type Response<Path_, Method extends AnyHTTPMethod = 'GET'>
  = Path_ extends keyof Exact
    ? Uppercase<Method> extends keyof Exact[Path_]
      ? 'response' extends keyof Exact[Path_][Uppercase<Method>]
        ? Exact[Path_][Uppercase<Method>]['response']
        : unknown
      : TypedFetchResponseBody<AugmentedServerRoutes, Path_, Method>
    : TypedFetchResponseBody<AugmentedServerRoutes, Path_, Method>

export type Methods<Path_> = TypedFetchMethods<AugmentedServerRoutes, Path_>

export type ResponseHeaders<Path_, Method extends AnyHTTPMethod = 'GET'> = TypedFetchResponseHeaders<AugmentedServerRoutes, Path_, Method>

export type ErrorBody<Path_, Method extends AnyHTTPMethod = 'GET'> = TypedFetchErrorBody<AugmentedServerRoutes, Path_, Method>

export type RequestBody<Path_, Method extends AnyHTTPMethod = 'GET', Fallback = BodyInit | null> = TypedFetchRequestBody<AugmentedServerRoutes, Path_, Method, Fallback>

export type RequestQuery<Path_, Method extends AnyHTTPMethod = 'GET', Fallback = Record<string, unknown>> = TypedFetchRequestQuery<AugmentedServerRoutes, Path_, Method, Fallback>

export type RequestHeaders<Path_, Method extends AnyHTTPMethod = 'GET', Fallback = HeadersInit> = TypedFetchRequestHeaders<AugmentedServerRoutes, Path_, Method, Fallback>

export type Requires<Path_, Method extends AnyHTTPMethod, Field extends 'body' | 'query' | 'headers'> = TypedFetchRequires<AugmentedServerRoutes, Path_, Method, Field>
export type StrictFetchPaths = true
export type RouteTypesEngine = 'generated'"
`;
