# Committed generated ui-templates output; pin LF so regeneration on any OS diffs cleanly.
packages/nuxt/src/app/components/error-404.vue text eol=lf
packages/nuxt/src/app/components/error-500.vue text eol=lf
packages/nuxt/src/app/components/welcome.vue text eol=lf
packages/nuxt/src/runtime/server/renderer/error-template.ts text eol=lf
packages/kit/src/internal/templates/spa-loading-icon.ts text eol=lf
packages/schema/src/templates/loading.ts text eol=lf

# pnpm patches must stay LF; pnpm 12's patch parser rejects CRLF, which autocrlf would introduce on Windows checkouts.
patches/*.patch text eol=lf
