{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>nuxt/renovate-config-nuxt:core",
    ":pinDevDependencies",
    ":widenPeerDependencies"
  ],
  "baseBranchPatterns": [
    "main",
    "4.x"
  ],
  "ignoreDeps": [
    "npm"
  ],
  "minimumReleaseAge": "1 day",
  "packageRules": [
    {
      "groupName": "vite and rolldown",
      "groupSlug": "rolldown",
      "matchPackageNames": [
        "vite",
        "rolldown",
        "rolldown-string",
        "tsdown",
        "oxc-parser",
        "oxc-transform",
        "oxc-walker",
        "@oxc-project/types"
      ],
      "description": "nuxt peers on rolldown loosely so package managers can reuse vite's copy, but this workspace pins it to vite's exact version via the catalog and an override. Bump them together or the workspace resolves a second rolldown and loads a second native binding."
    },
    {
      "groupName": "nitro",
      "groupSlug": "nitro",
      "dependencyDashboardApproval": true,
      "matchPackageNames": [
        "nitro",
        "h3",
        "ofetch",
        "rou3",
        "srvx",
        "unenv",
        "unstorage"
      ]
    },
    {
      "description": "The `nitropack` catalog on 4.x keeps rou3 0.9, the pattern syntax Nuxt uses to match Nitro 2 route rules. rou3 0.10 and later follow URLPattern syntax.",
      "matchBaseBranches": [
        "4.x"
      ],
      "matchDepTypes": [
        "pnpm.catalog.nitropack"
      ],
      "matchPackageNames": [
        "rou3"
      ],
      "allowedVersions": "<0.10.0"
    },
    {
      "description": "CI pins Node.js to the minimum version in `engines`, so it is bumped by hand.",
      "matchManagers": [
        "github-actions"
      ],
      "matchDepNames": [
        "node"
      ],
      "enabled": false
    },
    {
      "matchPackageNames": [
        "@types/node"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    }
  ],
  "vulnerabilityAlerts": {
    "postUpdateOptions": [
      "pnpmDedupe"
    ]
  }
}
