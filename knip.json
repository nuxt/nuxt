{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreWorkspaces": ["test/fixtures/basic"],
  "ignoreDependencies": [
    "bing",
    "uno.css",
    "somepath",
    "foo",
    "sherif",
    "pkg-pr-new"
  ],
  "ignoreUnresolved": [
    "^#build/",
    "^#internal/",
    "^#shared/",
    "^#nitro-internal-pollyfills$",
    "^#spa-template$",
    "\\.\\./schema\\.ts$",
    "\\.\\./hmr-sibling-layer$"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*"
      ]
    },
    "test/fixtures/*": {
      "entry": [
        "**/*.{js,ts,mjs,vue}"
      ],
      "paths": {
        "~~/*": ["./*"],
        "~/*": ["./*"]
      }
    },
    "packages/nitro-server": {
      "entry": [
        "src/runtime/**/*.{js,ts,mjs}"
      ]
    },
    "packages/kit": {
      "entry": [
        "test/**/*-fixture/**/*.{js,ts,mjs,cjs,cts,mts,vue}"
      ]
    },
    "packages/nuxt": {
      "entry": [
        "src/app/**/*.ts",
        "src/app/*.ts",
        "src/*/runtime/**/*.{ts,js}",
        "src/core/templates.ts",
        "test/**/*-fixture/**/*.{js,ts,mjs,vue}"
      ]
    },
    "packages/ui-templates": {
      "entry": [
        "lib/*.ts"
      ]
    },
    "packages/webpack": {
      "ignoreDependencies": [
        "autoprefixer",
        "css-loader",
        "cssnano",
        "file-loader",
        "postcss-import",
        "postcss-loader",
        "postcss-url",
        "pug-plain-loader",
        "raw-loader",
        "url-loader"
      ]
    }
  }
}
