{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreWorkspaces": ["test/fixtures/basic"],
  "ignoreDependencies": [
    "bing",
    "uno.css",
    "somepath",
    "foo",
    "sherif",
    "pkg-pr-new",
    "nuxt",
    "ofetch",
    "@nuxt/webpack-builder",
    "@nuxt/rspack-builder"
  ],
  "ignoreUnresolved": [
    "^#build/",
    "^#internal/",
    "^#shared/",
    "^#nitro-internal-pollyfills$",
    "^#spa-template$",
    "\\.\\./schema\\.ts$",
    "\\.\\./hmr-sibling-layer$"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*",
        "test/e2e/global.setup.ts",
        "test/e2e/global.teardown.ts",
        "test/runtime/app/**/*.ts"
      ]
    },
    "test/fixtures/*": {
      "entry": [
        "**/*.{js,ts,mjs,vue}"
      ],
      "paths": {
        "~~/*": ["./*"],
        "~/*": ["./*"]
      }
    },
    "packages/nitro-server": {
      "entry": [
        "src/runtime/**/*.{js,ts,mjs}"
      ],
      "ignoreDependencies": [
        "mocked-exports",
        "vue-devtools-stub",
        "@babel/plugin-proposal-decorators",
        "@babel/plugin-syntax-typescript"
      ]
    },
    "packages/vite": {
      "entry": [
        "src/fix-stacktrace.ts"
      ],
      "ignoreDependencies": [
        "mocked-exports",
        "nitropack",
        "@babel/plugin-proposal-decorators",
        "@babel/plugin-syntax-jsx"
      ]
    },
    "packages/kit": {
      "entry": [
        "test/**/*-fixture/**/*.{js,ts,mjs,cjs,cts,mts,vue}"
      ]
    },
    "packages/nuxt": {
      "entry": [
        "src/app/**/*.{ts,vue}",
        "src/*/runtime/**/*.{ts,js,vue}",
        "src/core/templates.ts",
        "meta.d.ts",
        "test/**/*-fixture/**/*.{js,ts,mjs,vue}"
      ],
      "ignoreDependencies": [
        "@dxup/nuxt",
        "@nuxt/devtools",
        "@nuxt/telemetry",
        "@nuxt/vite-builder"
      ]
    },
    "packages/ui-templates": {
      "entry": [
        "lib/*.ts"
      ],
      "ignoreDependencies": [
        "@vue/shared"
      ]
    },
    "packages/webpack": {
      "ignoreDependencies": [
        "autoprefixer",
        "css-loader",
        "cssnano",
        "file-loader",
        "postcss-import",
        "postcss-loader",
        "postcss-url",
        "pug-plain-loader",
        "raw-loader",
        "url-loader"
      ]
    }
  }
}
